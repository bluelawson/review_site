generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "mysql"
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String
  plan             String   @default("guest")
  reviewsSubmitted Int      @default(0)
  reviews          Review[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Review {
  id                String   @id @default(cuid())
  shopName          String
  castName        String   @map("workerName")
  estimatedAge      String?
  bodyType          String?
  bustSize          String?
  heightCm          Int?
  personality       String?
  headline          String
  detail            String
  serviceHighlights Json?
  castRating            Float   @map("rating")
  reviewRating      Float    @default(0)
  isPublished       Boolean  @default(true)
  damage            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  author   User   @relation(fields: [authorId], references: [id])
  authorId String
}
